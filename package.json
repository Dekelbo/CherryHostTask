{
  "name": "cherry-host-ai-poc",
  "version": "0.1.0",
  "private": true,
  "description": "Cherry Host / REJ Investment — AI Engineer assessment: an isolated, grounded two-agent (Finance + HR) proof of concept.",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:mock": "cross-env LLM_PROVIDER=mock tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.114.0",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
