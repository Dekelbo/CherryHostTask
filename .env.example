# Cherry Host / REJ — environment configuration
#
# The project runs fully OFFLINE with no key: the default provider is `mock`,
# which serves committed fixtures. Copy this file to `.env` and set a real key
# only when you want to hit the live Anthropic API.
#
#   cp .env.example .env        (PowerShell: Copy-Item .env.example .env)

# Provider: "mock" (default, keyless, uses committed fixtures) or "anthropic".
LLM_PROVIDER=mock

# Required ONLY when LLM_PROVIDER=anthropic. Never commit a real key.
ANTHROPIC_API_KEY=

# Model tiers (optional; sensible defaults are applied when unset).
# Routing/classification runs on the cheap fast tier; analysis/coordination on a mid tier.
ANTHROPIC_ROUTING_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_ANALYSIS_MODEL=claude-sonnet-5

# LLM client hardening (optional).
LLM_REQUEST_TIMEOUT_MS=30000
LLM_MAX_RETRIES=3

# Cumulative token budget for a single run, across every provider call.
# This is enforced: once reached, further calls are refused rather than logged.
# Protects against a runaway loop or an unexpectedly expensive fan-out.
LLM_TOKEN_BUDGET=200000

# Unbacked-number scanner: "reject" (default) refuses answers whose prose contains
# an ungrounded number; "warn" downgrades that to a non-fatal warning.
UNBACKED_NUMBER_MODE=reject
